DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusbite_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campusbite_dev"
JWT_SECRET="change-this-to-a-random-string"
PORT=3001
# Origin of the Vue app (only needed if you call the API cross-origin instead of via the Vite proxy)
CLIENT_URL="http://localhost:5173"
# Campus time zone for opening hours and pickup slots
TZ="Africa/Kigali"
# Set to the number of proxies in front of the API when deployed (e.g. 1), so rate limits see real client IPs
# TRUST_PROXY=1
